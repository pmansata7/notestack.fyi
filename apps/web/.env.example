# Copy to `.env.local` for local dev (never commit secrets).

# --- Supabase (Project Settings → API) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- macOS download (public URL, e.g. Supabase Storage or GitHub Releases) ---
# Leave empty to show "Coming soon" on the download button.
VITE_MAC_DOWNLOAD_URL=

# Optional: analytics / release metadata (not required for deploy)
# VITE_SITE_URL=https://notestack.fyi
